# Copy to .env.production and fill in every value. `make prod-up` refuses to start if any is missing.
ENV=production
GOVLENS_DOMAIN=govlens.example.org

POSTGRES_PASSWORD=            # openssl rand -base64 24
QDRANT_API_KEY=               # openssl rand -hex 24
ADMIN_PASSWORD=               # first admin account; change after first sign-in

OLLAMA_MODEL=qwen3:4b-instruct
CORS_ORIGINS=                 # leave empty: the UI is served from the same origin
RATE_LIMIT_PER_MINUTE=120
LOG_FORMAT=json

# Optional
HTTP_PORT=80
HTTPS_PORT=443
BACKUP_KEEP=14                # daily database backups to keep
QUERY_LOG_RETENTION_DAYS=90   # delete stored questions after this many days (0 = keep)
AUDIT_LOG_RETENTION_DAYS=365
LOGIN_MAX_FAILURES=5          # lock an account after this many wrong passwords
LOGIN_LOCKOUT_MINUTES=15
