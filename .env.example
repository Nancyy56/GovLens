# PostgreSQL Configuration
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=govlens
POSTGRES_USER=govlens_user
POSTGRES_PASSWORD=changeme

# Qdrant Configuration
QDRANT_HOST=qdrant
QDRANT_PORT=6333

# Application Configuration
ENV=development
DEBUG=True

# Ollama Configuration
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen3:4b-instruct
# Keep the model loaded after a request ("0" = unload: ~5 s slower, prevents memory build-up on laptops)
OLLAMA_KEEP_ALIVE=0

# Ask the LLM for metadata the patterns missed (values are checked against the text)
METADATA_LLM_FALLBACK=True

# Retrieval Configuration
HYBRID_SEARCH_ENABLED=True
RERANKER_ENABLED=True
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# Reranked chunks below this score are dropped as irrelevant (0 disables)
RERANKER_MIN_SCORE=0.01

# Security Configuration
# Sign-in is required. The first admin is created at startup when no users exist;
# if ADMIN_PASSWORD is empty, a password is generated into data/initial_admin_password.txt.
AUTH_ENABLED=True
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Hours a sign-in session lasts
TOKEN_TTL_HOURS=12
# Optional service keys for scripts, comma-separated: "key" (admin) or "key:VIEWER" / "key:EDITOR"
API_KEYS=
# Requests per minute per user or key. 0 disables rate limiting.
RATE_LIMIT_PER_MINUTE=60
# Sign-in attempts per minute per client IP
LOGIN_RATE_LIMIT_PER_MINUTE=10
# "database" shares limits across API workers; "memory" is per process
RATE_LIMIT_BACKEND=database
# Comma-separated browser origins allowed to call the API, e.g. http://localhost:3000
CORS_ORIGINS=

# Logging: LOG_FORMAT is "text" or "json"
LOG_LEVEL=INFO
LOG_FORMAT=text
